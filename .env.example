# =============================================================================
# .env.example — E-Commerce Fraud Detection
# =============================================================================
#
# Copy this file to .env and fill in your own values before running anything.
#
#   cp .env.example .env
#
# NEVER commit your real .env to version control.
# The .gitignore already excludes it.
# =============================================================================



# AWS Credentials

# Used by MLflow for S3 artifact storage and boto3 calls.
# Create an IAM user with S3 read/write on your MLflow bucket.
# Docs: https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_access-keys.html

ACCOUNT_ID=123456789012
AWS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
SECTRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_PROFILE=default
AWS_SHARED_CREDENTIALS_FILE=~/.aws/credentials
AWS_CONFIG_FILE=~/.aws/config

# KMS key ARN for server-side encryption of S3 objects (optional)
# Leave blank to use default S3 encryption.
S3_KMS_KEY_ARN=arn:aws:kms:ap-south-1:123456789012:key/your-kms-key-id-here



# S3 Bucket

# Bucket used to store MLflow artifacts (models, plots, metadata).
# Must exist before running the pipeline.

S3_BUCKET=your-mlflow-artifacts-bucket-name



# MLflow Tracking

# For LOCAL development: use file-based tracking (no server needed).
#   MLFLOW_TRACKING_URI=file:./mlruns
#
# For DOCKER stack (make stack-start): use the container hostname.
#   MLFLOW_TRACKING_URI=http://mlflow:5001
#
# For PRODUCTION: point to your remote MLflow server.
#   MLFLOW_TRACKING_URI=http://your-mlflow-server:5001

MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://${S3_BUCKET}/mlflow-artifacts



# Database — PostgreSQL (used by Airflow + MLflow in Docker)

# Change these before deploying to any shared or production environment.

RDS_HOST=localhost
RDS_PORT=5432
RDS_USERNAME=fraud_user
RDS_PASSWORD=change_me_before_production
RDS_DB_NAME=analytics

# Separate logical databases inside the same Postgres instance
RDS_ANALYTICS_DB=analytics
RDS_AIRFLOW_DB=airflow
RDS_MLFLOW_DB=mlflow



# Airflow

# UID of the host user that owns mounted volumes.
# On Linux:  run `id -u` and paste the result here.
# On Mac/Windows Docker Desktop: 50000 is the standard default.

AIRFLOW_UID=50000

# Airflow admin credentials (used by make airflow-init)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me_before_production

# Fernet key for encrypting Airflow connection passwords.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_generated_fernet_key_here



# Kafka / Streaming

# For local Docker stack use the internal Docker DNS name.
#   KAFKA_BOOTSTRAP_SERVERS=kafka:9092
#
# For host-machine access to the Docker Kafka broker use the external listener.
#   KAFKA_BOOTSTRAP_SERVERS=localhost:9093

KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Delay between producer events — lower = faster replay, higher = more realistic
STREAMING_DELAY_SECS=0.05



# Docker Compose

COMPOSE_PROJECT_NAME=fraud-detection
DOCKER_BUILDKIT=1



# Python runtime

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1



# Optional — External API Keys

# Add any additional API keys your extensions may require below.
# Example: GROQ_API_KEY=your_groq_api_key_here
